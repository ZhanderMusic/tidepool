{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tidepool",
  "version": "1.5.0",
  "identifier": "com.zhandermusic.tidepool",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tidepool",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Tidepool",
    "longDescription": "A calm idle game about growing a tide pool.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
